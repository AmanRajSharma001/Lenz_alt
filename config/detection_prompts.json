{
  "version": "2.0.0",
  "description": "Lenz Open-Vocabulary Detection Prompt Configuration",
  "dino_text_query": "person . seated person . standing person . dining table . chair . occupied chair . car . motorcycle . bicycle . bus . truck . backpack . handbag . suitcase . bottle . cup . laptop . phone . rubbish on a tabletop . dishes on a tabletop .",
  "categories": {
    "person": {
      "prompts": ["person", "seated person", "standing person"],
      "canonical_name": "person",
      "threshold": 0.28,
      "color_bgr": [235, 180, 50],
      "group": "human"
    },
    "dining_table": {
      "prompts": ["dining table", "table"],
      "canonical_name": "dining table",
      "threshold": 0.25,
      "color_bgr": [150, 130, 90],
      "group": "furniture"
    },
    "chair": {
      "prompts": ["chair", "occupied chair"],
      "canonical_name": "chair",
      "threshold": 0.25,
      "color_bgr": [180, 180, 100],
      "group": "furniture"
    },
    "vehicle": {
      "prompts": ["car", "motorcycle", "bicycle", "bus", "truck"],
      "canonical_name": "vehicle",
      "threshold": 0.28,
      "color_bgr": [50, 150, 250],
      "group": "vehicle"
    },
    "belongings": {
      "prompts": ["backpack", "handbag", "suitcase"],
      "canonical_name": "bag",
      "threshold": 0.25,
      "color_bgr": [210, 80, 220],
      "group": "personal_item"
    },
    "electronics": {
      "prompts": ["laptop", "phone"],
      "canonical_name": "electronics",
      "threshold": 0.25,
      "color_bgr": [255, 140, 0],
      "group": "purposeful_item"
    },
    "tableware": {
      "prompts": ["bottle", "cup", "dishes on a tabletop"],
      "canonical_name": "tableware",
      "threshold": 0.22,
      "color_bgr": [80, 210, 120],
      "group": "table_item"
    },
    "rubbish": {
      "prompts": ["rubbish on a tabletop"],
      "canonical_name": "rubbish",
      "threshold": 0.20,
      "color_bgr": [40, 50, 235],
      "group": "waste_item"
    }
  },
  "default_box_threshold": 0.25,
  "default_text_threshold": 0.25,
  "clip_table_classification": {
    "model_id": "openai/clip-vit-base-patch32",
    "classes": {
      "occupied": [
        "a dining table with people sitting",
        "an occupied dining table",
        "people eating at a dining table",
        "customers seated around a table"
      ],
      "unoccupied_clean": [
        "an empty clean dining table",
        "a clean cleared dining table with no items",
        "an empty restaurant table ready for guests",
        "a wiped clean empty table"
      ],
      "unoccupied_dirty": [
        "an empty dining table with dirty dishes and leftover food",
        "a messy dining table with trash and dirty plates",
        "an uncleared restaurant table with garbage",
        "dishes and rubbish left on an empty table"
      ],
      "uncertain": [
        "an unclear view of a table",
        "blurry or heavily obstructed view of a table surface",
        "dark unidentifiable surface"
      ]
    }
  }
}

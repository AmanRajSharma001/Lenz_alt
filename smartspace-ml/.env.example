# ─── Video Source ───────────────────────────────────────────────
VIDEO_SOURCE=sample.mp4
CAMERA_ID=cam_01

# ─── Processing ─────────────────────────────────────────────────
PROCESS_FPS=5
FRAME_WIDTH=640

# ─── YOLO ───────────────────────────────────────────────────────
YOLO_WEIGHTS=yolov8n.pt
POSE_WEIGHTS=yolov8n-pose.pt
YOLO_CONF=0.35
YOLO_IOU=0.45
POSE_ENABLED=true

# ─── Zone state-machine timers (seconds of VIDEO time) ──────────
OCCUPY_ENTER_S=2
OCCUPY_EXIT_S=15
IDLE_LIMIT_S=300
IDLE_MOTION_THRESHOLD=0.02
UNATTENDED_OBJECT_S=120
LOITER_S=180
MAX_PEOPLE_PER_ZONE=10
ZONE_RELOAD_INTERVAL_S=5

# ─── Gemma ──────────────────────────────────────────────────────
# Options: mock | transformers | llamacpp
GEMMA_MODE=mock
GEMMA_MODEL_ID=google/gemma-3-4b-it
GEMMA_DEVICE=auto
GEMMA_MAX_NEW_TOKENS=200
GEMMA_LLAMACPP_URL=http://localhost:8080
GEMMA_COOLDOWN_S=30
GEMMA_QUEUE_SIZE=10
GEMMA_IMAGE_MAX_PX=512

# ─── Alerts ─────────────────────────────────────────────────────
ALERT_CONFIDENCE=0.7
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MINUTES=5

# ─── Evidence ───────────────────────────────────────────────────
EVIDENCE_DIR=./evidence
EVIDENCE_BUFFER_S=15
BLUR_FACES=false
EVIDENCE_FPS=10

# ─── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
